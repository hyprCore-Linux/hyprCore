#!/bin/bash
# Waybar on-click helpers. Capture click XY, then detach long-lived UIs so
# Waybar cannot kill them when the click handler returns.
set -eu

export PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
_uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${_uid}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "${HYPRCORE_CLICK_XY:-}" ]; then
	HYPRCORE_CLICK_XY="$(/usr/bin/hyprctl cursorpos 2>/dev/null | tr -d ' ' || true)"
	export HYPRCORE_CLICK_XY
fi

_detach_settings() {
	# hyprcore-settings → show_hub (Waybar pill popover).
	if [ ! -x /usr/local/bin/hyprcore-settings ]; then
		return 1
	fi
	if command -v systemd-run >/dev/null 2>&1; then
		systemd-run --user --collect --quiet \
			--property=KillMode=process \
			--setenv="HYPRCORE_CLICK_XY=${HYPRCORE_CLICK_XY:-}" \
			--setenv="PATH=${PATH}" \
			--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
			--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
			--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
			--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
			--setenv="DISPLAY=${DISPLAY:-}" \
			--setenv="HOME=${HOME}" \
			-- /usr/local/bin/hyprcore-settings "$@"
		return 0
	fi
	setsid -f env HYPRCORE_CLICK_XY="${HYPRCORE_CLICK_XY:-}" \
		/usr/local/bin/hyprcore-settings "$@" >/dev/null 2>&1 || true
	return 0
}

_settings() {
	_detach_settings "$@" && exit 0
	echo "hyprcore-waybar-click: hyprcore-settings unavailable" >&2
	exit 1
}

case "${1:-}" in
	btop | cpu-btop | memory-btop)
		if [ -x "${HOME}/.local/bin/hyprcore-btop" ]; then
			exec "${HOME}/.local/bin/hyprcore-btop"
		fi
		if [ -x /usr/local/bin/hyprcore-btop ]; then
			exec /usr/local/bin/hyprcore-btop
		fi
		echo "hyprcore-waybar-click: hyprcore-btop unavailable" >&2
		exit 1
		;;
	sound | volume | audio | pulse)
		# Open Sound already on the volume slider, not the Volume/Output menu.
		_settings sound volume
		;;
	network | wifi | nm)
		_settings wifi
		;;
	battery)
		if [ -x /usr/local/bin/hyprcore-power-settings ]; then
			if command -v systemd-run >/dev/null 2>&1; then
				systemd-run --user --collect --quiet \
					--property=KillMode=process \
					--setenv="HYPRCORE_CLICK_XY=${HYPRCORE_CLICK_XY:-}" \
					--setenv="PATH=${PATH}" \
					--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
					--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
					--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
					--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
					--setenv="HOME=${HOME}" \
					-- /usr/local/bin/hyprcore-power-settings
				exit 0
			fi
			exec /usr/local/bin/hyprcore-power-settings
		fi
		_settings system
		;;
	datetime | clock | calendar)
		_settings datetime calendar
		;;
	weather | forecast)
		_settings weather
		;;
	sync | gtk-sync | gtksync)
		_settings sync
		;;
	settings)
		_settings system
		;;
	cpu)
		_settings system
		;;
	memory | ram | mem)
		_settings system
		;;
	power | session)
		_settings power
		;;
	*)
		echo "hyprcore-waybar-click: unknown action '${1:-}'" >&2
		exit 1
		;;
esac
