#!/bin/sh
# Load hyprtabs when window-chrome prefs ask for it.
# hyprbars, hyprframes, and Hyprspace are not part of this desktop.
set -eu

PREFS_A="${HOME}/.config/hypr/hyprcore-window-chrome.json"
PREFS_B="${HOME}/.config/hypr/neuronix-window-chrome.json"
PLUGIN_DIR="/usr/lib/x86_64-linux-gnu/hyprland/plugins"

command -v hyprctl >/dev/null 2>&1 || exit 0

_tabs_on() {
	python3 - "$PREFS_A" "$PREFS_B" <<'PY'
import json, sys
on = False
for path in sys.argv[1:]:
    try:
        data = json.load(open(path, encoding="utf-8"))
    except Exception:
        continue
    if isinstance(data, dict) and data.get("hyprtabs"):
        on = True
sys.exit(0 if on else 1)
PY
}

_plugin_loaded() {
	hyprctl plugin list 2>/dev/null | grep -qi "$1"
}

_load_hyprtabs() {
	_plugin_loaded hyprtabs && return 0
	for PLUGIN_SO in \
		"${HOME}/.local/lib/hyprland/plugins/libhyprtabs.so" \
		"/usr/local/lib/hyprland/plugins/libhyprtabs.so" \
		"${PLUGIN_DIR}/libhyprtabs.so"; do
		[ -f "${PLUGIN_SO}" ] || continue
		hyprctl plugin load "${PLUGIN_SO}" >/dev/null 2>&1 || true
		_plugin_loaded hyprtabs && return 0
	done
	return 0
}

if _tabs_on; then
	_load_hyprtabs
	_plugin_loaded hyprtabs && hyprctl keyword plugin:hyprtabs:enabled true >/dev/null 2>&1 || true
elif _plugin_loaded hyprtabs; then
	hyprctl keyword plugin:hyprtabs:enabled false >/dev/null 2>&1 || true
fi
exit 0
