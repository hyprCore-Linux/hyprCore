#!/bin/sh
# Launch XFCE Power Manager settings with the suite GTK theme.
set -eu

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
_uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${_uid}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -r /usr/share/hyprcore/hyprcore-hyprland-session-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/hyprcore/hyprcore-hyprland-session-env.sh
	hyprcore_hyprland_session_env
fi

_css_home="${XDG_RUNTIME_DIR}/hyprcore-power-manager-gtk"
rm -rf "${_css_home}"
mkdir -p "${_css_home}/gtk-3.0"

# Keep theme/icon prefs from the real user config when present.
_user_cfg="${XDG_CONFIG_HOME:-${HOME}/.config}"
if [ -f "${_user_cfg}/gtk-3.0/settings.ini" ]; then
	cp "${_user_cfg}/gtk-3.0/settings.ini" "${_css_home}/gtk-3.0/settings.ini"
else
	printf '%s\n' '[Settings]' >"${_css_home}/gtk-3.0/settings.ini"
fi
# Keep suite gtk-theme chrome (switches, notebook tabs, …). Replacing gtk.css
# entirely left XFCE Power Manager on stock Adwaita blue.
if [ -f "${_user_cfg}/gtk-3.0/gtk.css" ]; then
	cp "${_user_cfg}/gtk-3.0/gtk.css" "${_css_home}/gtk-3.0/gtk.css"
else
	: >"${_css_home}/gtk-3.0/gtk.css"
fi
export GTK_THEME="${GTK_THEME:-hyprcore}"
export XDG_CONFIG_HOME="${_css_home}"
exec xfce4-power-manager-settings "$@"
