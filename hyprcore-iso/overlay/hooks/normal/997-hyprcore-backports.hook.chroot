#!/bin/sh
# Hyprland 0.56.2 (snapshot) + sid companions. Kernel is hook 996.
set -e

_suite="$(. /etc/os-release 2>/dev/null && printf '%s' "${VERSION_CODENAME:-trixie}")"
[ -n "${_suite}" ] || _suite="trixie"
_backports="${_suite}-backports"

# Ensure backports channel (used for latest Debian 13 kernel via hook 996).
if [ -f /etc/apt/sources.list ] && ! grep -qE "[[:space:]]${_backports}[[:space:]]" /etc/apt/sources.list 2>/dev/null; then
	printf '\ndeb http://deb.debian.org/debian %s main contrib non-free non-free-firmware\n' "${_backports}" \
		>>/etc/apt/sources.list
	echo "[hyprcore-hyprland] added ${_backports} to sources.list"
fi

if [ ! -x /usr/local/sbin/hyprcore-install-hyprland-backports.sh ]; then
	echo "[hyprcore-hyprland] ERROR: missing /usr/local/sbin/hyprcore-install-hyprland-backports.sh" >&2
	exit 1
fi

/usr/local/sbin/hyprcore-install-hyprland-backports.sh
exit 0
