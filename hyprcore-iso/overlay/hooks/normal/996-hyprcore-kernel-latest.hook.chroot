#!/bin/sh
# Ensure linux-image/headers metas from Debian 13 trixie-backports (latest 7.x).
# NVIDIA DKMS freeze removed.
set -e

if [ ! -x /usr/local/sbin/hyprcore-install-kernel-latest.sh ]; then
	echo "[hyprcore-kernel] ERROR: missing /usr/local/sbin/hyprcore-install-kernel-latest.sh" >&2
	exit 1
fi

/usr/local/sbin/hyprcore-install-kernel-latest.sh
exit 0
