#!/bin/sh
# Live ISO squashfs: Cursor from official apt repo (downloads.cursor.com).
set -e
if [ -x /usr/share/hyprcore/install-cursor.sh ]; then
	/usr/share/hyprcore/install-cursor.sh
elif [ -f /usr/share/hyprcore/install-cursor.sh ]; then
	chmod 0755 /usr/share/hyprcore/install-cursor.sh
	/usr/share/hyprcore/install-cursor.sh
else
	echo "9945-hyprcore-cursor: missing install-cursor.sh" >&2
	exit 1
fi
