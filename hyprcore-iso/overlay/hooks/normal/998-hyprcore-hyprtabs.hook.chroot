#!/bin/sh
# Build hyprtabs against the ISO Hyprland 0.56.2 ABI.
# Title bars (hyprbars), image borders (hyprframes), and Hyprspace are not used.
set -e

PLUGIN_DIR=/usr/lib/x86_64-linux-gnu/hyprland/plugins

if ! command -v apt-get >/dev/null 2>&1; then
	echo "[hyprcore-hypr-plugins] skip: no apt-get" >&2
	exit 0
fi

if ! command -v hyprctl >/dev/null 2>&1 && ! dpkg -s hyprland >/dev/null 2>&1; then
	echo "[hyprcore-hypr-plugins] skip: hyprland not installed yet" >&2
	exit 0
fi

# hyprland-dev must match the pinned 0.56.2 compositor (not backports 0.55 / sid 0.57).
if [ -x /usr/local/sbin/hyprcore-install-hyprland-backports.sh ]; then
	/usr/local/sbin/hyprcore-install-hyprland-backports.sh --with-dev \
		|| echo "[hyprcore-hypr-plugins] WARNING: could not install hyprland-dev 0.56.2" >&2
fi

DEBIAN_FRONTEND=noninteractive apt-get install -y \
	cmake g++ meson ninja-build pkg-config git \
	libpixman-1-dev libpango1.0-dev libcairo2-dev \
	libdrm-dev libinput-dev libudev-dev libwayland-dev libxkbcommon-dev \
	|| {
		echo "[hyprcore-hypr-plugins] WARNING: could not install build deps" >&2
		exit 0
	}

_workdir="$(mktemp -d)"
cleanup() { rm -rf "${_workdir}"; }
trap cleanup EXIT

mkdir -p "${PLUGIN_DIR}"

HYPRTABS_SRC=/usr/src/hyprcore/hyprtabs
HYPRTABS_SO_LOCAL=/usr/local/lib/hyprland/plugins/libhyprtabs.so
HYPRTABS_SO="${PLUGIN_DIR}/libhyprtabs.so"
if [ -f "${HYPRTABS_SRC}/Makefile" ]; then
	_ht_build="${_workdir}/hyprtabs-build"
	mkdir -p "${_ht_build}" /usr/local/lib/hyprland/plugins
	cp -a "${HYPRTABS_SRC}/." "${_ht_build}/"
	if make -C "${_ht_build}" -j"$(nproc 2>/dev/null || echo 2)"; then
		_so="${_ht_build}/hyprtabs.so"
		if [ -f "${_so}" ]; then
			install -m 0755 "${_so}" "${HYPRTABS_SO}"
			install -m 0755 "${_so}" "${HYPRTABS_SO_LOCAL}"
			echo "[hyprcore-hypr-plugins] installed ${HYPRTABS_SO_LOCAL}"
		fi
	else
		echo "[hyprcore-hypr-plugins] WARNING: hyprtabs build failed" >&2
	fi
else
	echo "[hyprcore-hypr-plugins] WARNING: no ${HYPRTABS_SRC} (setup.sh did not stage hyprtabs)" >&2
fi

exit 0
