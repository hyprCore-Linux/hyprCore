# hyprCore Debian (trixie) profile — sourced by hyprcore-iso/setup.sh and build.sh

HYPRCORE_PROFILE_ID=debian
HYPRCORE_DISTRO=debian
HYPRCORE_SUITE=trixie
HYPRCORE_PRODUCT_NAME=hyprCore
HYPRCORE_PRODUCT_VERSION=0.1
HYPRCORE_LIVE_HOSTNAME=hyprcore-hyprland

HYPRCORE_BUILD_ROOT_VAR=HYPRCORE_BUILD_ROOT
# Live-build tree + generated package lists (never written into hyprcore-iso/overlay).
HYPRCORE_BUILD_ROOT_DEFAULT="/var/tmp/hyprcore-build-${USER}"

LB_MODE=
LB_DISTRIBUTION=trixie
LB_PARENT_DISTRIBUTION=
LB_ARCHIVE_AREAS="main contrib non-free non-free-firmware"
LB_MIRROR=
LB_LINUX_FLAVOURS=
LB_INITRAMFS=
LB_LIVE_USER_PASSWORD=live
LB_FORCE_LIVE_LIST=0
LB_UBUNTU_KEYRING_CHECK=0

HYPRCORE_DESKTOP_SESSION=hyprcore-hyprland
HYPRCORE_CALAMARES_INSTALLER=calamares-install-debian
HYPRCORE_WELCOME_URLS=debian.org,deb.debian.org
HYPRCORE_ENABLE_BACKPORTS=1
HYPRCORE_FLATPAK_DECIBELS=0

HYPRCORE_DISTRO_CONF=debian.distro.conf
HYPRCORE_GRUB_FALLBACK_MSG="Debian testing GRUB art"
